{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "devtools-hub": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "editor.main.css",
                "input": "node_modules/monaco-editor/min/vs/editor",
                "output": "monaco"
              },
              {
                "glob": "ort-wasm-simd-threaded.{wasm,mjs}",
                "input": "node_modules/onnxruntime-web/dist",
                "output": "ort"
              },
              {
                "glob": "avif_enc.wasm",
                "input": "node_modules/@jsquash/avif/codec/enc",
                "output": "avif"
              },
              {
                "glob": "jq.wasm",
                "input": "node_modules/jq-wasm/dist/build",
                "output": "jq"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "serviceWorker": "ngsw-config.json",
            "outputMode": "static",
            "allowedCommonJsDependencies": ["pako", "papaparse", "utif", "cronstrue", "js-beautify", "acorn", "nearley", "@jridgewell/resolve-uri", "source-map-js/lib/source-map-generator.js", "ajv", "ajv-formats", "semver", "bowser", "fast-deep-equal", "json-schema-traverse", "fast-uri"],
            "security": {
              "allowedHosts": []
            },
            "loader": {
              ".css": "empty"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "devtools-hub:build:production"
            },
            "development": {
              "buildTarget": "devtools-hub:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
