// Cloudflare Workers config. The site is fully prerendered, so it is served as
// static assets only: no Worker code runs and requests stay on the free tier.
{
  "name": "devtools-hub",
  "compatibility_date": "2026-10-01",
  // The site's own domain. Cloudflare creates the DNS records and certificates;
  // the zone must be active in this Cloudflare account first.
  "routes": [
    { "pattern": "devtools24.in", "custom_domain": true },
    { "pattern": "www.devtools24.in", "custom_domain": true }
  ],
  // Keep the workers.dev address too, as a backup for networks whose DNS
  // does not resolve the new domain yet.
  "workers_dev": true,
  "assets": {
    "directory": "./dist/devtools-hub/browser",
    // Unknown URLs get 404.html with a 404 status (see scripts/postbuild.mjs).
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
