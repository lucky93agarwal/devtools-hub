// Cloudflare Workers config. The site is fully prerendered and served as static
// assets. Only /api/* (accounts) runs Worker code (worker/index.ts) with a D1
// database; every other request is served as a file, as before.
{
  "name": "devtools-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The site's own domain. Cloudflare creates the DNS records and certificates;
  // the zone must be active in this Cloudflare account first.
  "routes": [
    { "pattern": "devtools24.in", "custom_domain": true },
    { "pattern": "www.devtools24.in", "custom_domain": true }
  ],
  // Keep the workers.dev address too, as a backup for networks whose DNS
  // does not resolve the new domain yet.
  "workers_dev": true,
  "assets": {
    "directory": "./dist/devtools-hub/browser",
    // Unknown URLs get 404.html with a 404 status (see scripts/postbuild.mjs).
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "binding": "ASSETS",
    // The Worker only runs for the API; pages and files skip it.
    "run_worker_first": ["/api/*"]
  },
  // Accounts database. For local testing this id is only a name; before going live a
  // real D1 database is created and its id goes here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devtools24-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
